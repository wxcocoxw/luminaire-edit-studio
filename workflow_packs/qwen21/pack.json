{
  "format_version": 1,
  "id": "qwen21",
  "display_name": "Qwen Image 2.1",
  "version": "1.4.0",
  "status": "supported",
  "engine_module": "luminaire.engines.qwen21",
  "workflow": "workflow_packs/qwen21/QWEN_IMAGE_21_STUDIO.json",
  "workflow_manifest": "workflow_packs/qwen21/workflow_manifest.json",
  "api_directory": "workflow_packs/qwen21/api/v1_3",
