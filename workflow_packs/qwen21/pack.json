      "target": "QWEN_IMAGE_21_STUDIO.json"
    },
    {
      "source": "workflow_packs/qwen21/workflow_manifest.json",
      "target": "workflow_manifest.json"
    },
    {
      "source": "workflow_packs/qwen21/api",
      "target": "api"
    },
    {
      "source": "workflow_packs/qwen21/prompts",
      "target": "prompts"
    }
