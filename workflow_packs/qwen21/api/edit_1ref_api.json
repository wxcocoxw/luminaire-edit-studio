{
  "model_loader": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "model_cache": {
    "class_type": "QwenImage21Cache",
    "inputs": {
      "model": [
        "model_loader",
        0
      ],
      "device": "auto",
      "dtype": "default"
    }
  },
  "clip_loader": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "vae_loader": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "texture_fix_vae_for_qwen_image_2.1_bf16.safetensors"
    }
  },
  "source_input": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "REPLACE_WITH_UPLOADED_SOURCE.png"
    }
  },
  "prompt_text": {
    "class_type": "PrimitiveStringMultiline",
    "inputs": {
      "value": "Describe the edit. Preserve everything not mentioned."
    }
  },
  "prepare": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "source_input",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 2.0,
      "resolution_steps": 32
    }
  },
  "encode": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": [
        "clip_loader",
        0
      ],
      "vae": [
        "vae_loader",
        0
      ],
      "prompt": [
        "prompt_text",
        0
      ],
      "negative_prompt": "",
      "resolution": 0,
      "images.image_1": [
        "prepare",
        0
      ],
      "images.image_2": [
        "reference_1_size",
        0
      ]
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "model_cache",
        0
      ],
      "positive": [
        "encode",
        0
      ],
      "negative": [
        "encode",
        1
      ],
      "latent_image": [
        "encode",
        2
      ],
      "seed": 42,
      "steps": 40,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "vae_loader",
        0
      ]
    }
  },
  "save_raw": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "Qwen21Studio/api/edit/raw"
    }
  },
  "save_final": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "Qwen21Studio/api/edit/final"
    }
  },
  "reference_1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "REPLACE_WITH_REFERENCE_1.png"
    }
  },
  "reference_1_size": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "reference_1",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 1.0,
      "resolution_steps": 32
    }
  }
}
